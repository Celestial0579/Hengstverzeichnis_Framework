# Auto-generated database configuration (contains secrets, generated by the Setup Wizard)
config/db_config.php

# Docker/Env-Konfiguration mit lokalen Secrets
.env

# Von Nutzern hochgeladene Inhalte (Logos, Pferdefotos) - keine Repo-Inhalte
public/uploads/*
!public/uploads/.htaccess

# Lokale Claude-Code-Einstellungen (Tool-Berechtigungen, Dev-Server-Konfig)
.claude/

# Plugins leben bewusst in eigenen Repositories (siehe docs/plugin-development.md),
# nicht im Kern-Repo - nur die leere Verzeichnisstruktur wird versioniert.
plugins/*
!plugins/.gitkeep

# Dev-only Composer-Abhängigkeiten (PHPUnit) - nicht Teil der Anwendungs-Runtime,
# siehe composer.json und docs/development.md
vendor/
.phpunit.cache/

# Laufzeitzustand (z. B. Wartungs-Marker var/wartung.lock, siehe
# App\Service\Maintenance) - nur die leere Verzeichnisstruktur wird versioniert
var/*
!var/.gitkeep

# Laufzeit-Protokolle (App\Service\AuditLogger faellt bei nicht erreichbarer
# Datenbank auf eine Datei zurueck) - nur die leere Verzeichnisstruktur wird
# versioniert. Ohne diese Regel erzeugt jeder Testlauf einen Diff im
# Arbeitsverzeichnis, und Fehlermeldungen einzelner Laeufe landen im Repo.
storage/logs/*
!storage/logs/.gitkeep
