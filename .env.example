# Kopieren nach .env und Werte anpassen. .env wird NICHT committet (siehe .gitignore).

# Datenbankverbindung (Hostname "db" entspricht dem Service-Namen in docker-compose.yml)
DB_HOST=db
DB_PORT=3306
DB_NAME=hengstverzeichnis
DB_USER=hengst_user
DB_PASS=change-me
# Nur für den db-Container beim ersten Start (MariaDB Root-Passwort), nicht von der App selbst genutzt
DB_ROOT_PASS=change-me-too

# Mit `php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"` generieren
APP_KEY=

APP_ENV=production
# APP_URL=https://hengstverzeichnis.example.org

# Nur setzen, wenn ein Reverse Proxy/Load Balancer davor steht: IP(s)/CIDR-Netze,
# denen X-Forwarded-For/X-Forwarded-Proto vertraut werden darf. Siehe README.
# TRUSTED_PROXIES=172.16.0.0/12
# Optional: Sind ALLE vier Werte gesetzt, wird der Setup-Wizard komplett
# übersprungen und der erste Admin-Account automatisch angelegt.
# Ist nur ein Teil gesetzt, zeigt der Wizard nur die fehlenden Abschnitte.
SITE_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
