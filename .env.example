# Kopieren nach .env und Werte anpassen. .env wird NICHT committet (siehe .gitignore).

# Datenbankverbindung (Hostname "db" entspricht dem Service-Namen in docker-compose.yml)
DB_HOST=db
DB_PORT=3306
DB_NAME=hengstverzeichnis
DB_USER=hengst_user
# DB_PASS und DB_ROOT_PASS sind Pflicht für docker-compose.yml und hier bewusst
# leer: ./docker-start.sh setzt beim Anlegen der .env Zufallswerte, wer die
# Datei von Hand kopiert, trägt selbst welche ein. Ohne Werte bricht
# `docker compose` ab, statt den Datenbankkonten öffentlich bekannte
# Beispielwerte zu geben (GHSA-58h6-g9mx-7ffr).
DB_PASS=
# MariaDB-Root-Passwort, nur beim ersten Start des db-Containers wirksam. Die
# App nutzt es nicht, der App-Container bekommt es leer.
DB_ROOT_PASS=

# Mit `php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"` generieren
APP_KEY=

APP_ENV=production

# DRINGEND EMPFOHLEN: die öffentliche Adresse der Instanz. Sie steht in den
# Links der Passwort-Reset-, Verifizierungs- und Adressbestätigungs-Mails.
# Ohne APP_URL, ohne TRUSTED_HOSTS und ohne Stamm-URL in den
# Systemeinstellungen werden diese Mails NICHT verschickt (Schutz gegen
# Reset-Link-Poisoning über den Host-Header), Selbstregistrierung und
# Adressänderung sind dann gesperrt. Siehe docs/security.md.
# APP_URL=https://hengstverzeichnis.example.org
# Alternative zu APP_URL (mehrere Hostnamen): Allowlist für den Host-Header,
# führender Punkt = beliebige Subdomain.
# TRUSTED_HOSTS=hengstverzeichnis.example.org,.example.org

# Nur setzen, wenn ein Reverse Proxy/Load Balancer davor steht: IP(s)/CIDR-Netze,
# denen X-Forwarded-For/X-Forwarded-Proto vertraut werden darf. Siehe README.
# TRUSTED_PROXIES=172.16.0.0/12
# Optional: Sind ALLE vier Werte gesetzt, wird der Setup-Wizard komplett
# übersprungen und der erste Admin-Account automatisch angelegt. Anmelden
# danach unter /login mit ADMIN_USERNAME oder ADMIN_EMAIL und ADMIN_PASSWORD.
# Sobald eine ADMIN_*-Variable gesetzt ist, müssen alle gültig sein (kein
# reservierter Name wie "admin", kein "@" im Namen, kein Beispielpasswort) -
# sonst zeigt /setup nur eine Fehlerseite ohne Formular.
# Nur SITE_NAME ohne ADMIN_*: Der Wizard zeigt nur die fehlenden Abschnitte.
SITE_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
